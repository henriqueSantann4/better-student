{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal. Adicione permissões só quando uma funcionalidade precisar delas.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "allow-versao-nucleo",
    "allow-abrir-suap",
    "allow-email-conectar",
    "allow-email-conectado",
    "allow-email-desconectar",
    "allow-email-buscar",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://myaccount.google.com/*" }]
    }
  ]
}
