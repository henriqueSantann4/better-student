{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal. Adicione permissões só quando uma funcionalidade precisar delas.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "allow-versao-nucleo",
    "updater:default",
    "process:allow-restart",
    "allow-abrir-suap",
    "allow-fechar-suap-escondido",
    "allow-email-conectar",
    "allow-email-conectado",
    "allow-email-desconectar",
    "allow-email-buscar",
    "allow-moodle-conectar",
    "allow-moodle-fechar-escondido",
    "allow-moodle-conectado",
    "allow-moodle-chave",
    "allow-moodle-desconectar",
    "allow-materiais-pasta-padrao",
    "allow-materiais-listar",
    "allow-materiais-copiar",
    "allow-materiais-abrir",
    "allow-materiais-baixar-moodle",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}
